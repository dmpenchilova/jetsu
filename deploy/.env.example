# ===== Боевой сервер: скопируйте в .env и заполните =====

# Домены (DNS-записи A должны указывать на этот сервер)
SITE_DOMAIN=jet.su
ADMIN_DOMAIN=admin.jet.su
# Почта для уведомлений Let's Encrypt о сертификатах
ACME_EMAIL=admin@jet.su

# Из каких сетей можно входить в админку (через пробел). Пусто — отовсюду.
# Пример: 203.0.113.0/24 198.51.100.7
ADMIN_ALLOW_IPS=

# Секреты: сгенерируйте каждый командой  openssl rand -hex 32
PAYLOAD_SECRET=
REVALIDATE_SECRET=
DB_PASSWORD=

# Почта для писем о заявках
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@jet.su

# Яндекс SmartCaptcha: ключ клиента (для сайта) и ключ сервера
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Где лежит папка сайта относительно этой папки
FRONT_DIR=../../jet-front-main

# Резервные копии
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# ===== Стенд =====
# prod — боевой. test / dev — тестовый: сайт закрыт от поисковиков, письма о заявках уходят
# только на STAND_EMAIL_TO, в админке видна метка стенда.
STAND_NAME=prod
STAND_EMAIL_TO=
# Для второго стенда на том же сервере: своё имя проекта и порты (иначе — отдельный сервер)
# COMPOSE_PROJECT_NAME=jetsu-test
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ===== Оповещения о сбоях =====
# Telegram: создайте бота у @BotFather, добавьте в чат дежурных, chat_id узнайте у @getidsbot
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# и/или почта (через тот же SMTP), адреса через запятую
ALERT_EMAIL=

# ===== Вход в админку =====
# Роли, которым двухфакторный вход обязателен (через запятую): admin,editor,author,hr
TWO_FACTOR_REQUIRED_ROLES=admin
# Корпоративный SSO (OpenID Connect). Адрес возврата у провайдера: https://<ADMIN_DOMAIN>/cms-api/users/sso/callback
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_LABEL=Войти через корпоративный SSO
SSO_ALLOWED_DOMAINS=jet.su
# Роль для сотрудников, которых ещё нет в админке (author / editor / hr). Пусто — входят только заведённые
SSO_AUTO_CREATE_ROLE=

# ===== Копии в облако (Yandex Object Storage или другое S3-хранилище) =====
S3_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=prod/
S3_KEEP_DAYS=90
