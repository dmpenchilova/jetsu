# База данных PostgreSQL (docker compose up -d поднимает её на 5432)
DATABASE_URL=postgres://jet:jet@127.0.0.1:5432/jet_admin
# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=
# Адрес админки, по которому её открывают в браузере
SERVER_URL=http://localhost:3001
# Адрес фронта jet-front-main и секрет для сброса его кэша (тот же REVALIDATE_SECRET, что во фронте)
FRONT_URL=http://localhost:3000
REVALIDATE_SECRET=
