# Для docker compose нужен только PAYLOAD_SECRET (и при желании REVALIDATE_SECRET),
# остальное задано в docker-compose.yml. Для запуска без Docker заполните всё.

# Ключ шифрования сессий, не короче 32 символов: openssl rand -hex 32
PAYLOAD_SECRET=
# Секрет сброса кэша фронта — тот же, что REVALIDATE_SECRET во фронте
REVALIDATE_SECRET=dev-secret

# --- без Docker ---
# при разработке: подстраивать схему базы под код без миграций
# PAYLOAD_DB_PUSH=true
DATABASE_URL=postgres://jet:jet@127.0.0.1:5432/jet_admin
SERVER_URL=http://localhost:3001
FRONT_URL=http://localhost:3000
# FRONT_INTERNAL_URL=
# MEDIA_PUBLIC_URL=
# MEDIA_DIR=
# Папка фронта для импорта тестовых данных
FRONT_DIR=../jet-front-main
